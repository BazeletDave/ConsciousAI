{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRI Evidence Registry",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "organization",
          "type",
          "claim",
          "source",
          "verification_status",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "type": {
            "enum": [
              "observation",
              "company_report",
              "hypothesis"
            ]
          },
          "claim": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "verification_status": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
