{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRI synthetic governance event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "moving",
    "handling_detected",
    "driver_attribution_verified",
    "confidence",
    "source_type"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "moving": {
      "type": "boolean"
    },
    "handling_detected": {
      "type": "boolean"
    },
    "driver_attribution_verified": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_type": {
      "const": "synthetic"
    }
  }
}
